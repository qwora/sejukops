# Public client configuration (Supabase project URL + anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# One-click reviewer accounts (server only). Shared password for the 3 accounts in lib/demo-accounts.ts.
DEMO_ACCOUNT_PASSWORD=

# AI (server only). On Vercel the AI Gateway works with no key via the built-in OIDC token.
# Set a key only for local development or to use a specific gateway key.
AI_GATEWAY_API_KEY=
# Optional comma-separated model fallback list, e.g. google/gemini-3.7-flash,openai/gpt-6.1-terra
AI_MODEL=

# Future WhatsApp Cloud API (not used yet; wa.me deep links are used instead)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
